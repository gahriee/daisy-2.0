  "narrative": {
    "northStar": "Garden Ledger",
    "overview": "Warm paper-like surfaces and forest actions give Daisy a grounded, orderly character. Geist keeps labels and operational copy direct. The approved system uses light surfaces; it does not automatically substitute a dark palette.",
    "keyCharacteristics": [
      "Linen canvas and white working surfaces.",
      "Forest primary actions and restrained gold emphasis.",
      "Quiet borders, compact labels and generous control targets."
    ],
    "rules": [
      {
        "name": "The Text Carries Status Rule",
        "body": "Color supplements a clear status label. Pending intent must never be presented as a confirmed business result.",
        "section": "colors"
      },
      {
        "name": "Recovery Form States",
        "body": "Recovery uses a narrow native POST form, stable polite feedback and error summaries, associated field errors and explicit focus transitions. Disable controls during pending requests, clear sensitive state only after acknowledged success, and distinguish interrupted responses from confirmed failure. Never persist recovery secrets or place them in URLs.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use semantic tokens rather than copying palette values into screens.",
      "Do keep controls labeled and preserve visible keyboard focus.",
      "Do keep pending, stale, error and confirmed states distinct in words.",
      "Do use flat panels and tonal status surfaces."
    ],
    "donts": [
      "Don't add business rules, database calls or authorization to primitives.",
      "Don't use color alone to identify status or error.",
      "Don't remove a loading action's label or rely on a spinner alone.",
      "Don't describe source checks as rendered or real-device verification."
    ]
  }
}
