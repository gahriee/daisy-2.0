{
  "name": "daisy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:check": "tsx scripts/db-check.ts",
    "check:neon": "node --conditions=react-server --import tsx scripts/neon-check.ts",
    "check:app": "node scripts/app-check.mjs",
    "check:auth": "node scripts/auth-check.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@maplibre/maplibre-gl-geocoder": "^1.9.4",
    "@neon/auth": "0.8.2",
    "@neon/config": "1.14.0",
    "@neon/env": "^2.1.3",
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "apexcharts": "4.7.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "docx": "^9.15.4",
    "dotenv": "^18.0.10",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^6.2.5",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27"
  }
}
