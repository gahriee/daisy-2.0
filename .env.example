# Normally use a development branch. Production provisioning requires explicit authorization.
DATABASE_URL=
DIRECT_URL=
# Neon env pull supplies this direct connection alias; Prisma accepts either name.
DATABASE_URL_UNPOOLED=
# Separate, explicitly opted-in integration-test database; never production.
TEST_DATABASE_URL=

NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
OWNER_USER_ID=
APP_ORIGIN=http://localhost:3000
# Optional dev-only comma-separated hostnames/IPs allowed by Next.js 16 dev server (e.g. 192.168.1.50).
ALLOWED_DEV_ORIGINS=
# Dedicated HMAC secret for opaque sync cursors (falls back to NEON_AUTH_COOKIE_SECRET).
SYNC_CURSOR_SECRET=
# Shared secret authenticating scheduled job Route Handlers (never NEXT_PUBLIC_).
CRON_SECRET=

# Branch-scoped Neon Object Storage credentials; server-only, never NEXT_PUBLIC_.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional PWA Web Push VAPID keys (generate with `pnpm exec tsx scripts/generate-vapid.ts`).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Billing, receipt, and operational policies (server-only, optional; defaults shown).
BILLING_DAY_OF_MONTH=1
BILLING_GRACE_PERIOD_DAYS=5
# DAILY_EXACT | DAILY_30 | HALF_MONTH | NONE
BILLING_PRORATION_POLICY=DAILY_EXACT
# HOLD_SEPARATE | APPLY_ON_MOVE_OUT | APPLY_TO_LAST_MONTH
BILLING_DEPOSIT_POLICY=HOLD_SEPARATE
# CREDIT_NEXT_INVOICE | REJECT_OVERPAYMENT
BILLING_OVERPAYMENT_POLICY=CREDIT_NEXT_INVOICE
INVOICE_PREFIX=INV-
RECEIPT_PREFIX=RCP-

# Operational upload, offline unlock, and default stay-time limits (optional; defaults shown).
OFFLINE_UNLOCK_MAX_DAYS=7
PROOF_MAX_MB=5
PROOF_MAX_FILES_PER_RECORD=5
DEFAULT_CHECK_IN_TIME=14:00
DEFAULT_CHECK_OUT_TIME=12:00

# Optional Semaphore SMS credentials and overdue reminder configuration (server-only, never NEXT_PUBLIC_).
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
SEMAPHORE_OVERDUE_FREQUENCY_DAYS=1
SEMAPHORE_OVERDUE_TEMPLATE=

# Optional SMTP settings for Nodemailer booking emails (server-only, never NEXT_PUBLIC_).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
